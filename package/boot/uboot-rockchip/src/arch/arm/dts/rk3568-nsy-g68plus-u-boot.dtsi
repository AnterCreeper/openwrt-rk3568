#include "rk356x-u-boot.dtsi"

&pcie3x2 {
	pinctrl-0 = <&pcie30x2_reset>;
};

&pinctrl {
	pcie {
		pcie30x2_reset: pcie30x2-reset {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&sdhci {
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
};
