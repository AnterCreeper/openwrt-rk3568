/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rockchip/rk3568.dtsi"

/ {
	model = "NSY-G68+ AX3000 Router";
	compatible = "nsy,g68plus", "rockchip,rk3568";

	aliases {
		mmc0 = &sdhci;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
	};

	chosen: chosen {
		stdout-path = "serial2:1500000n8";
	};

	vcc0v9_cpu: regulator-cpu {
		compatible = "pwm-regulator";
		rockchip,pwm_id = <0>;
		rockchip,pwm_voltage = <900000>;
		pwms = <&pwm0 0 25000 1>;
		regulator-name = "vcc0v9_cpu";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1400000>;
		regulator-init-microvolt = <1150000>;
		regulator-enable-ramp-delay = <300>;
		regulator-ramp-delay = <8000>;
	};

	vcc1v8_adc: regulator-adc {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_adc";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc3v3_sys: regulator-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc3v3_pcie: regulator-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <5000>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcie_pwren>;
	};

	vcc5v0_usb: regulator-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb0_pwren>;
	};

	adc_keys: adc-keys {
		status = "okay";
		compatible = "adc-keys";
		poll-interval = <100>;
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;

		recovery-key {
			label = "reset";
			linux,code = <KEY_RESTART>;
			press-threshold-microvolt = <450000>;
		};
	};

	leds {
		compatible = "gpio-leds";
		led-power {
			label = "led-power";
			default-state = "on";
			gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&led_power>;
		};
		/*
		led-system is controlled by mt7916
		 */
	};
};

&pwm0 {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vcc0v9_cpu>;
};

&cpu1 {
	cpu-supply = <&vcc0v9_cpu>;
};

&cpu2 {
	cpu-supply = <&vcc0v9_cpu>;
};

&cpu3 {
	cpu-supply = <&vcc0v9_cpu>;
};

&pmu_io_domains {
	status = "okay";
	pmuio2-supply = <&vcc3v3_sys>;
	vccio1-supply = <&vcc3v3_sys>;
	vccio3-supply = <&vcc3v3_sys>;
	vccio4-supply = <&vcc3v3_sys>;
	vccio5-supply = <&vcc3v3_sys>;
	vccio6-supply = <&vcc3v3_sys>;
	vccio7-supply = <&vcc3v3_sys>;
};

//On-board UART
&uart2 {
	status = "okay";
};

//Reset Key
&saradc {
	status = "okay";
	vref-supply = <&vcc1v8_adc>;
};

//Pinctrl
&pinctrl {
	usb {
		usb0_pwren: usb0-pwren {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	regulator-en {
		pcie_pwren: pcie-pwren {
			rockchip,pins = <0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie {
		pcie2x1_reset: pcie2x1-reset {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		pcie30x1_reset: pcie30x1-reset {
			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		pcie30x2_reset: pcie30x2-reset {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	gmac-reset {
		gmac0_reset: gmac0-reset {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		led_power: led-power {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

//On-board eMMC
&sdhci {
	status = "okay";
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	supports-emmc;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
};

//Internal
&tsadc {
	status = "okay";
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <0>;
};

//USB2.0
&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

//3x MULTI_PHY
&combphy0 { //configured as USB3.0 otg, work in host mode
	status = "okay";
};

&usb_host0_xhci {
	status = "okay";
	dr_mode = "host";
	extcon = <&usb2phy0>;
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb>;
};

&usb2phy0_otg {
	status = "okay";
};

&combphy1 { //configured as SGMII
	status = "okay";
	rockchip,sgmii-mac-sel = <1>;
};

&combphy2 { //configured as PCIE2.0x1
	status = "okay";
};

&pcie2x1 { //wifi0
	status = "okay";
	rockchip,perst-inactive-ms = <500>;
	reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2x1_reset>;
};

//2x PCIE3.0x1
&pcie30phy {
	status = "okay";
	data-lanes = <1 2>;
};

&pcie3x1 { //wifi1
	status = "okay";
	num-lanes = <0x1>;
	reset-gpios = <&gpio0 RK_PC3 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x1_reset>;
};

&pcie3x2 { //nvme0
	status = "okay";
	num-lanes = <0x1>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
	reset-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x2_reset>;
};

//Dual Ethernet MAC
&mdio0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	ethernet-switch@1d {
		compatible = "realtek,rtl8365mb";
		reg = <29>;
		reset-assert-us = <20000>;
		reset-deassert-us = <1000000>;
		reset-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&gmac0_reset>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			ethernet-port@0 {
				reg = <0>;
				label = "lan3";
				phy-handle = <&switchphy0>;
			};
			ethernet-port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&switchphy1>;
			};
			ethernet-port@2 {
				reg = <2>;
				label = "lan1";
				phy-handle = <&switchphy2>;
			};
			ethernet-port@3 {
				reg = <3>;
				label = "lan0";
				phy-handle = <&switchphy3>;
			};
			ethernet-port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&switchphy4>;
			};
			ethernet-port@6 {
				reg = <6>;
				ethernet = <&gmac1>;
				phy-mode = "sgmii";
				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
			ethernet-port@7 {
				reg = <7>;
				ethernet = <&gmac0>;
				phy-mode = "rgmii";
				tx-internal-delay-ps = <0>;
				rx-internal-delay-ps = <0>;
				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;
			switchphy0: ethernet-phy@0 {
				reg = <0>;
			};
			switchphy1: ethernet-phy@1 {
				reg = <1>;
			};
			switchphy2: ethernet-phy@2 {
				reg = <2>;
			};
			switchphy3: ethernet-phy@3 {
				reg = <3>;
			};
			switchphy4: ethernet-phy@4 {
				reg = <4>;
			};
		};

		leds {
			#address-cells = <1>;
			#size-cells = <0>;
			led-link-spd {
				reg = <0>;
				type = <0x9>;
				port = <0x1f>;
			};
			led-link-txd {
				reg = <1>;
				type = <0x3>;
				port = <0x1f>;
			};
			led-link-act {
				reg = <2>;
				type = <0x2>;
				port = <0x1f>;
			};
		};
	};
};

&gmac0 {
	status = "okay";
	phy-mode = "rgmii";
	clock_in_out = "output";
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX &cru SCLK_GMAC0>;
	assigned-clock-rates = <0 125000000>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	tx_delay = <0x4f>;
	rx_delay = <0x0f>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2 &gmac0_rgmii_clk &gmac0_rgmii_bus>;

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&xpcs {
	status = "okay";
};

&gmac1 {
	status = "okay";
	phy-mode = "sgmii";
	rockchip,xpcs = <&xpcs>;
	rockchip,pipegrf = <&pipegrf>;
	phys = <&combphy1 PHY_TYPE_SGMII>;
	power-domains = <&power RK3568_PD_PIPE>;
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>;
	assigned-clock-parents = <&gmac1_xpcsclk>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m1_miim>;

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};
